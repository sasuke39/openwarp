+/// Isolate an AI-requested command at the PTY boundary so shell state changes such as `set -x`,
+/// `cd`, exports, aliases, and traps do not leak into Warp's persistent interactive shell. Keep
+/// this decoration out of the agent action itself so command cards, approvals, and conversation
+/// history continue to show the original command.
+fn isolate_ai_requested_command(command: &str, shell_type: Option<ShellType>) -> String {
+    match shell_type {
+        Some(ShellType::Fish) => {
+            let escaped = command.replace('\\', "\\\\").replace('\'', "\\'");
+            format!("command fish -c '{escaped}'")
+        }
+        Some(ShellType::PowerShell) => format!("& {{\n{command}\n}}"),
+        Some(ShellType::Bash | ShellType::Zsh) | None => format!("(\n{command}\n)"),
+    }
+}
