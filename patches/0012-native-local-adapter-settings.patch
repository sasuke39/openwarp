+/// Mirrors the adapter's profileNameRE: letters, digits, '-', '_' and Han
+/// characters, at most 64 runes (`char::is_alphanumeric` covers Han).
+fn is_valid_profile_name(name: &str) -> bool {
+    !name.is_empty()
+        && name.chars().count() <= 64
+        && name
+            .chars()
+            .all(|c| c.is_alphanumeric() || c == '-' || c == '_')
+}
