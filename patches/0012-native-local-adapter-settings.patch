+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum HarnessPreset {
+    Native,
+    PiAgent,
+    DeepSeekHarness,
+    Custom,
+}
+
+impl HarnessPreset {
+    fn all() -> [Self; 4] {
+        [
+            Self::Native,
+            Self::PiAgent,
+            Self::DeepSeekHarness,
+            Self::Custom,
+        ]
+    }
+
+    fn label(self) -> &'static str {
+        match self {
+            Self::Native => "Native OpenWarp",
+            Self::PiAgent => "Pi Agent",
+            Self::DeepSeekHarness => "DeepSeek Harness",
+            Self::Custom => "Custom Sidecar",
+        }
+    }
+
+    fn driver(self) -> &'static str {
+        match self {
+            Self::Native => "native",
+            Self::PiAgent => "pi-agent",
+            Self::DeepSeekHarness => "deepseek-harness",
+            Self::Custom => "custom",
+        }
+    }
+
+    fn description(self) -> &'static str {
+        match self {
+            Self::Native => "使用 OpenWarp 内置 Go Agent Loop，不启动 Sidecar。",
+            Self::PiAgent => "由 Pi 管理 Agent Loop、重试、压缩和会话状态。",
+            Self::DeepSeekHarness => {
+                "由 DeepSeek Harness 管理 Agent Loop、工具、子 Agent 和会话状态。"
+            }
+            Self::Custom => "启动实现 OpenWarp Agent Runtime Protocol v1 的自定义 Sidecar。",
+        }
+    }
+
+    fn from_stored(driver: &str) -> Self {
+        Self::all()
+            .into_iter()
+            .find(|preset| preset.driver() == driver)
+            .unwrap_or(Self::Custom)
+    }
+
+    fn bundled_runtime_config(self) -> Option<AgentRuntimeConfig> {
+        let resource_dir = match self {
+            Self::PiAgent => "pi-runtime",
+            Self::DeepSeekHarness => "dsh-runtime",
+            _ => return None,
+        };
+        let executable = std::env::current_exe().ok()?;
+        let macos_dir = executable.parent()?;
+        if macos_dir.file_name()?.to_str()? != "MacOS" {
+            return None;
+        }
+        let contents_dir = macos_dir.parent()?;
+        Some(AgentRuntimeConfig {
+            driver: self.driver().to_owned(),
+            command: contents_dir
+                .join("Helpers")
+                .join("node-runtime")
+                .to_string_lossy()
+                .into_owned(),
+            args: vec![contents_dir
+                .join("Resources")
+                .join(resource_dir)
+                .join("dist")
+                .join("main.js")
+                .to_string_lossy()
+                .into_owned()],
+        })
+    }
+}
