+// ---------------------------------------------------------------------------
+// HTTP helpers. Every error is surfaced as a String; nothing here panics.
+// ---------------------------------------------------------------------------
+
+fn http_client() -> Result<reqwest::Client, String> {
+    reqwest::Client::builder()
+        .timeout(Duration::from_secs(REQUEST_TIMEOUT_SECS))
+        .build()
+        .map_err(|err| format!("failed to create HTTP client: {err}"))
+}
+
+/// Extracts the server's `{"error": "..."}` body on non-2xx responses.
+async fn ensure_success(response: reqwest::Response) -> Result<reqwest::Response, String> {
+    if response.status().is_success() {
+        return Ok(response);
+    }
+    let status = response.status();
+    #[derive(Deserialize)]
+    struct ErrorBody {
+        error: String,
+    }
+    let message = match response.text().await {
+        Ok(body) => serde_json::from_str::<ErrorBody>(&body)
+            .map(|body| body.error)
+            .unwrap_or_else(|_| format!("HTTP {status}")),
+        Err(_) => format!("HTTP {status}"),
+    };
+    Err(message)
+}
+
+async fn get_json<T: serde::de::DeserializeOwned>(url: String) -> Result<T, String> {
+    let client = http_client()?;
+    let response = client
+        .get(url)
+        .send()
+        .await
+        .map_err(|err| err.to_string())?;
+    ensure_success(response)
+        .await?
+        .json::<T>()
+        .await
+        .map_err(|err| err.to_string())
+}
+
+async fn fetch_snapshot_once() -> Result<RefreshSnapshot, String> {
+    let status = get_json::<AdapterStatus>(format!("{ADAPTER_BASE_URL}/settings/status")).await?;
+    let profiles = get_json::<ProfileListResponse>(format!("{ADAPTER_BASE_URL}/settings/profiles"))
+        .await?
+        .profiles;
+    let effective_config =
+        get_json::<AdapterConfig>(format!("{ADAPTER_BASE_URL}/settings/config")).await?;
+    Ok(RefreshSnapshot {
+        status,
+        profiles,
+        effective_config,
+    })
+}
+
+async fn fetch_snapshot() -> Result<RefreshSnapshot, String> {
+    let mut last_error = String::new();
+    for attempt in 0..INITIAL_CONNECT_ATTEMPTS {
+        match fetch_snapshot_once().await {
+            Ok(snapshot) => return Ok(snapshot),
+            Err(err) => last_error = err,
+        }
+        if attempt + 1 < INITIAL_CONNECT_ATTEMPTS {
+            Timer::after(Duration::from_millis(INITIAL_CONNECT_RETRY_MS)).await;
+        }
+    }
+    Err(last_error)
+}
+
+async fn fetch_profile_config(name: String) -> Result<AdapterConfig, String> {
+    get_json(format!("{ADAPTER_BASE_URL}/settings/profiles/{name}")).await
+}
+
+async fn post_profile(name: String, config: AdapterConfig) -> Result<(), String> {
+    let client = http_client()?;
+    let response = client
+        .post(format!("{ADAPTER_BASE_URL}/settings/profiles/{name}"))
+        .json(&config)
+        .send()
+        .await
+        .map_err(|err| err.to_string())?;
+    ensure_success(response).await.map(|_| ())
+}
+
+async fn post_activate_profile(name: String) -> Result<AdapterStatus, String> {
+    let client = http_client()?;
+    let response = client
+        .post(format!(
+            "{ADAPTER_BASE_URL}/settings/profiles/{name}/activate"
+        ))
+        .send()
+        .await
+        .map_err(|err| err.to_string())?;
+    ensure_success(response)
+        .await?
+        .json::<AdapterStatus>()
+        .await
+        .map_err(|err| err.to_string())
+}
+
+async fn delete_profile(name: String) -> Result<(), String> {
+    let client = http_client()?;
+    let response = client
+        .delete(format!("{ADAPTER_BASE_URL}/settings/profiles/{name}"))
+        .send()
+        .await
+        .map_err(|err| err.to_string())?;
+    ensure_success(response).await.map(|_| ())
+}
