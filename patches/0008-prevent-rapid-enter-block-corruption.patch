+#[test]
+fn test_rapid_enter_submits_only_once_per_block() {
+    App::test((), |mut app| async move {
+        initialize_app(&mut app);
+
+        let terminal = add_window_with_bootstrapped_terminal(&mut app, None, None).await;
+        let input = terminal.read(&app, |view, _| view.input().clone());
+
+        let (first_submission, duplicate_submission) = input.update(&mut app, |input, ctx| {
+            // Keep both submissions in one UI update so the PTY controller cannot advance the
+            // model between them. This reproduces two Enter events arriving in quick succession.
+            (
+                input.try_execute_command("", ctx),
+                input.try_execute_command("", ctx),
+            )
+        });
+
+        assert!(first_submission);
+        assert!(
+            !duplicate_submission,
+            "a second Enter must not submit another command for the same active block"
+        );
+    });
+}
