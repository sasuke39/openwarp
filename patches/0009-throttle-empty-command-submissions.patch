 #[test]
+fn test_rapid_empty_commands_are_throttled_across_blocks() {
+    App::test((), |mut app| async move {
+        initialize_app(&mut app);
+
+        let terminal = add_window_with_bootstrapped_terminal(&mut app, None, None).await;
+        let input = terminal.read(&app, |view, _| view.input().clone());
+
+        let first_submission =
+            input.update(&mut app, |input, ctx| input.try_execute_command("", ctx));
+        assert!(first_submission);
+
+        let second_submission = input.update(&mut app, |input, ctx| {
+            // Emulate the shell advancing to a fresh block before the next Enter event.
+            input.last_submitted_block_id = None;
+            input.try_execute_command("", ctx)
+        });
+        assert!(
+            !second_submission,
+            "rapid empty commands must be throttled even after the active block changes"
+        );
+    });
+}
