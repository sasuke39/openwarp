+                                    }
+                                    Err(error) => ActionResult::CommandFinished {
+                                        block_id: BlockId::new(),
+                                        output: format!(
+                                            "Remote command execution failed: {error:#}"
+                                        ),
+                                        exit_code: ExitCode::from(1),
+                                    },
+                                }
+                            },
+                            move |result, _| {
+                                action_result_for_requested_command(command_for_result, result)
+                            },
+                        );
+                    }
+                }
