+                        let command_for_result = command.clone();
+                        let current_working_directory = current_working_directory.clone();
+                        drop(model);
+
+                        return ActionExecution::new_async(
+                            async move {
+                                let result = session
+                                    .execute_command(
+                                        &command_to_execute,
+                                        current_working_directory.as_deref(),
+                                        None,
+                                        crate::terminal::model::session::ExecuteCommandOptions::default(),
+                                    )
+                                    .await;
+
+                                match result {
+                                    Ok(output) => {
+                                        let exit_code = output.exit_code().unwrap_or_else(|| {
+                                            ExitCode::from(if output.success() { 0 } else { 1 })
+                                        });
+                                        let output =
